# Gmail account to monitor
CLIENT_EMAIL=client@example.com

# Your mobile number. Asterisk must be configured to route this number.
MY_PHONE=+91XXXXXXXXXX

# Working hours in Asia/Kolkata
TIMEZONE=Asia/Kolkata
WORK_START=9
WORK_END=18

# Polling interval
POLL_SECONDS=30

# Set to 1 to start the Gmail monitor automatically with Flask
ENABLE_REPLY_MONITOR=1

# Asterisk settings
ASTERISK_SOUND_DIR=C:\path\shared\asterisk_sounds
ASTERISK_AMI_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=admin
ASTERISK_AMI_SECRET=change-me
ASTERISK_CHANNEL=Local/{phone}@from-internal
